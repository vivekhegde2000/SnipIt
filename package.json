{
  "name": "snipit",
  "private": true,
  "version": "0.0.0",
  "description": "SnipIt — a local-first PWA for saving, searching and copying reusable text snippets.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run dev -w @snipit/web",
    "build": "npm run build -w @snipit/web",
    "preview": "npm run preview -w @snipit/web",
    "lint": "npm run lint -w @snipit/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1"
  }
}
